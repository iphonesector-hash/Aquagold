# Runtime
AQUAGOLD_ENV=development
AQUAGOLD_DATABASE_URL=postgresql://aquagold:replace-me@127.0.0.1:5432/aquagold
AQUAGOLD_SECRET_KEY=replace-with-at-least-32-random-characters
AQUAGOLD_DB_PASSWORD=replace-with-a-local-postgres-password
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# First-run provisioning only; remove after the account exists
AQUAGOLD_ADMIN_USERNAME=admin
AQUAGOLD_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional policy and infrastructure
AQUAGOLD_SESSION_HOURS=24
AQUAGOLD_GLOBAL_RATE_LIMIT=600 per hour
AQUAGOLD_LOGIN_RATE_LIMIT=5 per minute; 20 per hour
RATELIMIT_STORAGE_URI=memory://
AQUAGOLD_MAX_REQUEST_BYTES=2097152

# Optional AI-assisted intake
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional map providers; public defaults are intended only for low-volume use
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org/search
ROUTING_PROVIDER_URL=https://router.project-osrm.org
AQUAGOLD_MAP_USER_AGENT=AquaGold-CRM/1.0 your-operations-email@example.com
