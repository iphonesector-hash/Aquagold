{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "aqua-bale-standalone/app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,Dockerfile,docker-compose.yml,nginx.conf}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/aqua-bale-standalone/app.py"
    }
  ]
}
