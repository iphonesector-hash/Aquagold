{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "fix/aqua-scoped-stability-20260901": true
    }
  },
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,Dockerfile,docker-compose.yml,nginx.conf}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/bale-reports",
      "schedule": "30 19 * * *"
    }
  ]
}
