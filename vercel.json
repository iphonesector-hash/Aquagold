{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]; then exit 0; else exit 1; fi",
  "git": {
    "deploymentEnabled": {
      "codex/aqua-ai-20260827": false,
      "codex/aquagold-immediate-shell": false,
      "codex/aquagold-production-hardening": false,
      "codex/aquagold-production-secret-hotfix": false,
      "codex/aquagold-ui-startup-timeout": false,
      "farangis-integration": false,
      "farangis-integration-v6": false,
      "feature/aqua-notify-finance-report-20260831": false,
      "feature/aquagold-finance-map-v3": false,
      "feature/aquagold-smart-crm-map": false,
      "feature/aquagold-usable-ui": false,
      "feature/bale-management-reports-20260831": false,
      "feature/bale-management-reports-clean-20260831": false,
      "feature/smart-gps-after-analysis": false,
      "fix/aria-ios-voice-send-20260831": false,
      "fix/aria-natural-speech-live-search-20260831": false,
      "fix/bale-self-report-delete-20260831": false,
      "fix/stability-without-ui-regression": false,
      "release-v8-qa": false,
      "release-v8-qa-2": false,
      "release-v8-work-final": false
    }
  },
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,Dockerfile,docker-compose.yml,nginx.conf}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/bale-reports",
      "schedule": "30 19 * * *"
    }
  ]
}
