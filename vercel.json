{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,Dockerfile,docker-compose.yml,nginx.conf}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/bale-reports",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/service-reminders",
      "schedule": "30 5 * * *"
    }
  ]
}
